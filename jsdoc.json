{
  "opts": {
    "destination": "./docs",
    "nocolor": true,
    "readme": "README.md",
    "recurse": true,
    "template": "node_modules/docdash",
    "verbose": true
  },
  "plugins": [
  ],
  "source": {
    "include": ["lib"],
    "includePattern": ".js$",
    "excludePattern": "(node_modules/|docs)"
  },
  "tags": {
  },
  "docdash": {
    "menu": {
      "GitHub": {
        "href": "https://github.com/pine/safe-storage"
      },
      "NPM": {
        "href": "https://www.npmjs.com/package/@pinemz/safe-storage"
      }
    }
  }
}
